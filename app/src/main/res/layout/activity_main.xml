<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Runs the full height: the bar floats over it, so content shows through the bar's fill. -->
    <include
        android:id="@+id/app_bar_main"
        layout="@layout/app_bar_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Stands in for the Home tab: a round button at the start of the bottom bar, kept clear of
         the bar itself so the two read as one dock. Fill and icon tint are set in MainActivity,
         since both follow the current destination. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/nav_bar_margin"
        android:contentDescription="@string/action_freeze_all"
        android:src="@drawable/ic_round_frozen"
        app:borderWidth="0dp"
        app:elevation="0dp"
        app:fabCustomSize="@dimen/fab_size"
        app:hoveredFocusedTranslationZ="0dp"
        app:layout_constraintBottom_toBottomOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottom_nav"
        app:maxImageSize="@dimen/fab_image_size"
        app:pressedTranslationZ="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <!-- Floats as a pill next to the freeze button; its rounded background is built in code so it
         can pick up the themed surface color with a hint of translucency. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/nav_bar_gap"
        android:layout_marginEnd="@dimen/nav_bar_margin"
        android:layout_marginBottom="@dimen/nav_bar_margin"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fab"
        app:menu="@menu/nav_main" />
</androidx.constraintlayout.widget.ConstraintLayout>
